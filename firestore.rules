rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function currentProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isCustomer() {
      return signedIn() && currentProfile().role == 'customer';
    }
    function isProvider() {
      return signedIn() && currentProfile().role == 'provider';
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['name', 'email', 'role'])
        && request.resource.data.keys().hasOnly(['name', 'email', 'role'])
        && request.resource.data.name is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role in ['customer', 'provider'];
      allow list, delete: if false;

      // A customer's device registers its notification token on its own
      // profile. Nothing else on the profile can change.
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
        && (!('fcmToken' in request.resource.data)
          || request.resource.data.fcmToken is string);
    }

    match /queues/{queueId} {
      allow read: if signedIn();
      allow create: if isProvider()
        && queueId == request.auth.uid
        && request.resource.data.keys().hasAll([
          'providerId', 'name', 'description', 'averageServiceMinutes', 'isOpen'
        ])
        && request.resource.data.keys().hasOnly([
          'providerId', 'name', 'description', 'averageServiceMinutes', 'isOpen'
        ])
        && request.resource.data.providerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.averageServiceMinutes is int
        && request.resource.data.averageServiceMinutes > 0
        && request.resource.data.isOpen == true
        && getAfter(counterPath(queueId)).data.lastTicket == 0;
      allow update, delete: if false;
    }

    function entryPath(entryId) {
      return /databases/$(database)/documents/entries/$(entryId);
    }
    function membershipPath(customerId) {
      return /databases/$(database)/documents/customerMemberships/$(customerId);
    }
    function counterPath(queueId) {
      return /databases/$(database)/documents/queueTicketCounters/$(queueId);
    }
    function serviceStatePath(queueId) {
      return /databases/$(database)/documents/queueServiceState/$(queueId);
    }
    function ownsQueue(queueId) {
      return isProvider()
        && get(/databases/$(database)/documents/queues/$(queueId)).data.providerId == request.auth.uid;
    }
    function createsOwnEntry(entryId) {
      return entryId is string
        && !exists(entryPath(entryId))
        && getAfter(entryPath(entryId)).data.customerId == request.auth.uid;
    }

    match /customerMemberships/{customerId} {
      function pointsToNewEntry() {
        return isCustomer()
          && customerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['entryId'])
          && createsOwnEntry(request.resource.data.entryId);
      }
      allow get: if signedIn() && customerId == request.auth.uid;
      allow create: if pointsToNewEntry();
      allow update: if pointsToNewEntry()
        && get(entryPath(resource.data.entryId)).data.status in ['left', 'served', 'skipped'];
    }

    match /queueTicketCounters/{queueId} {
      function allocatesTicket() {
        let entryId = request.resource.data.entryId;
        return isCustomer()
          && request.resource.data.keys().hasOnly(['lastTicket', 'entryId'])
          && request.resource.data.lastTicket is int
          && createsOwnEntry(entryId)
          && getAfter(entryPath(entryId)).data.queueId == queueId
          && getAfter(entryPath(entryId)).data.ticketNumber == request.resource.data.lastTicket;
      }
      allow get: if signedIn();
      function initializesNewQueue() {
        let queue = /databases/$(database)/documents/queues/$(queueId);
        return isProvider()
          && queueId == request.auth.uid
          && !exists(queue)
          && getAfter(queue).data.providerId == request.auth.uid
          && request.resource.data.keys().hasOnly(['lastTicket'])
          && request.resource.data.lastTicket == 0;
      }
      // Existing queues may need their first counter seeded from ticket history.
      allow create: if initializesNewQueue()
        || (allocatesTicket() && request.resource.data.lastTicket > 0);
      allow update: if allocatesTicket()
        && request.resource.data.lastTicket == resource.data.lastTicket + 1;
    }

    match /queueServiceState/{queueId} {
      function callsWaitingEntry() {
        let entryId = request.resource.data.entryId;
        let entry = get(entryPath(entryId)).data;
        return ownsQueue(queueId)
          && request.resource.data.keys().hasOnly(['entryId'])
          && entry.queueId == queueId
          && entry.status == 'waiting'
          && getAfter(entryPath(entryId)).data.status == 'called';
      }
      allow get: if ownsQueue(queueId);
      allow create: if callsWaitingEntry();
      allow update: if callsWaitingEntry()
        && get(entryPath(resource.data.entryId)).data.status in ['served', 'skipped'];
    }

    match /entries/{entryId} {
      // Phase 3: queue members' names and ticket statuses are visible to all
      // signed-in users. Do not store private information in these documents.
      allow read: if signedIn();
      allow create: if isCustomer()
        && request.resource.data.keys().hasAll([
          'customerId', 'customerName', 'queueId', 'ticketNumber',
          'joinedAt', 'status'
        ])
        && request.resource.data.keys().hasOnly([
          'customerId', 'customerName', 'queueId', 'ticketNumber',
          'joinedAt', 'status'
        ])
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.customerName == currentProfile().name
        && request.resource.data.queueId is string
        && exists(/databases/$(database)/documents/queues/$(request.resource.data.queueId))
        && get(/databases/$(database)/documents/queues/$(request.resource.data.queueId)).data.isOpen == true
        && request.resource.data.ticketNumber is int
        && request.resource.data.ticketNumber > 0
        && getAfter(membershipPath(request.auth.uid)).data.entryId == entryId
        && getAfter(counterPath(request.resource.data.queueId)).data.entryId == entryId
        && getAfter(counterPath(request.resource.data.queueId)).data.lastTicket == request.resource.data.ticketNumber
        && request.resource.data.joinedAt is timestamp
        && request.resource.data.status == 'waiting';

      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.customerId == request.auth.uid
            && resource.data.status == 'waiting'
            && request.resource.data.status == 'left')
          ||
          (ownsQueue(resource.data.queueId)
            && (
              (resource.data.status == 'waiting'
                && request.resource.data.status == 'called'
                && getAfter(serviceStatePath(resource.data.queueId)).data.entryId == entryId)
              ||
              (resource.data.status == 'called'
                && request.resource.data.status in ['served', 'skipped'])
            ))
        );
      allow delete: if false;
    }
  }
}
